{
  "name": "@framework-generico/framework-v5",
  "private": true,
  "version": "5.0.0-rc.1",
  "type": "module",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:schemas": "vitest run src/tests/schemas.contract.test.ts",
    "test:roundtrip": "vitest run src/tests/roundtrip.test.ts",
    "verify": "npm run typecheck && npm run build && npm run test && npm run audit",
    "audit:architecture": "node tools/audit-architecture.mjs",
    "audit:secrets": "node tools/audit-secrets.mjs",
    "audit:privacy": "node tools/audit-privacy.mjs",
    "audit:accessibility": "node tools/audit-accessibility.mjs",
    "audit": "npm run audit:architecture && npm run audit:secrets && npm run audit:privacy && npm run audit:accessibility && npm run audit:dependencies",
    "audit:dependencies": "npm audit --omit=dev --audit-level=moderate"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
